{
  "name": "skr-bill-calendar-backend",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for SKR's Bill Calendar",
  "license": "MIT",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "cli": "node dist/cli.js"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "bcryptjs": "3.0.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "express": "5.1.0",
    "express-rate-limit": "7.5.1",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "luxon": "3.6.1",
    "nodemailer": "6.10.1",
    "pino": "9.7.0",
    "pino-http": "10.5.0",
    "prisma": "6.16.2",
    "web-push": "3.6.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/luxon": "3.6.2",
    "@types/node": "22.15.30",
    "@types/nodemailer": "6.4.17",
    "@types/supertest": "6.0.3",
    "@types/web-push": "3.6.4",
    "pino-pretty": "13.0.0",
    "supertest": "7.1.1",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
