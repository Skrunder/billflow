{
  "name": "skr-bill-calendar",
  "version": "1.4.0",
  "private": true,
  "description": "Self-hosted bill & event calendar \u2014 monorepo (shared core, API, web app)",
  "license": "MIT",
  "workspaces": [
    "packages/core",
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "build:core": "npm run build -w @skr/core",
    "test": "npm run build:core && npm test --workspaces",
    "typecheck": "npm run build:core && npm run typecheck --workspaces"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "chai": "6.2.2",
    "std-env": "4.2.0",
    "tinyrainbow": "3.1.1",
    "@stencil/core": "4.45.1",
    "enhanced-resolve": "5.25.1"
  }
}
