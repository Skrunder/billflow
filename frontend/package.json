{
  "name": "skr-bill-calendar-frontend",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @skr/core",
    "dev": "vite",
    "dev:standalone": "npm run build -w @skr/core && vite --mode standalone",
    "prebuild": "npm run build -w @skr/core",
    "build": "tsc -b && vite build",
    "build:standalone": "npm run build -w @skr/core && tsc -b && vite build --mode standalone",
    "preview": "vite preview",
    "pretypecheck": "npm run build -w @skr/core",
    "typecheck": "tsc -b --noEmit",
    "pretest": "npm run build -w @skr/core",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "8.1.1",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.2",
    "@fullcalendar/core": "6.1.17",
    "@fullcalendar/daygrid": "6.1.17",
    "@fullcalendar/interaction": "6.1.17",
    "@fullcalendar/list": "6.1.17",
    "@fullcalendar/luxon3": "6.1.17",
    "@fullcalendar/react": "6.1.17",
    "@fullcalendar/timegrid": "6.1.17",
    "@skr/core": "1.1.0",
    "@tanstack/query-sync-storage-persister": "5.80.7",
    "@tanstack/react-query": "5.80.7",
    "@tanstack/react-query-persist-client": "5.80.7",
    "clsx": "2.1.1",
    "lucide-react": "0.511.0",
    "luxon": "3.6.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.4",
    "sql.js": "1.13.0",
    "workbox-core": "7.3.0",
    "workbox-expiration": "7.3.0",
    "workbox-precaching": "7.3.0",
    "workbox-routing": "7.3.0",
    "workbox-strategies": "7.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@types/luxon": "3.6.2",
    "@types/node": "22.15.30",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@types/sql.js": "1.4.9",
    "@vitejs/plugin-react": "4.5.2",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
    "vite": "6.4.3",
    "vite-plugin-pwa": "1.0.0",
    "vitest": "4.1.11"
  }
