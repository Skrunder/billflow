# Images are built from the repository root; keep the context small and
# never send secrets, data or local builds to the Docker daemon.
**/node_modules
**/dist
**/dev-dist
**/coverage
**/*.log
**/*.tsbuildinfo
.git
.github
docs
scripts
backups
backend/data
backend/tests
.env
.env.*
**/Dockerfile
.dockerignore
