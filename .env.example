# ─────────────────────────────────────────────────────────────────────────────
# BillFlow — configuration
# Copy to `.env` next to docker-compose.yml and adjust. Only POSTGRES_PASSWORD
# is required; everything else has a sensible default.
# Full reference: docs/ENVIRONMENT.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────
# Database password. Generate one with:  openssl rand -hex 24
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# ── Public URL & networking ──────────────────────────────────────────────────
# The URL people use to open the app (used in emails and to decide whether
# cookies are marked Secure). Use https:// when behind a TLS reverse proxy.
APP_URL=http://localhost:8080
# Host port the web UI is published on.
APP_PORT=8080
# Bind address for the published port (127.0.0.1 = only reachable via a local reverse proxy).
APP_BIND_ADDRESS=0.0.0.0
# Which proxies to trust for X-Forwarded-* headers (Express "trust proxy").
# Default trusts private networks (Docker, LAN proxies, cloudflared containers).
TRUST_PROXY=loopback, linklocal, uniquelocal
# auto = Secure cookies when APP_URL starts with https://
COOKIE_SECURE=auto

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=billcalendar
POSTGRES_DB=billcalendar
# Optional host paths instead of Docker named volumes (e.g. on Unraid/TrueNAS):
# DB_DATA_PATH=/mnt/user/appdata/skr-bill-calendar/postgres
# APP_DATA_PATH=/mnt/user/appdata/skr-bill-calendar/data

# ── Security ─────────────────────────────────────────────────────────────────
# Leave empty to auto-generate one on first start (stored in the app data volume).
# To set your own:  openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12
# Allow new sign-ups (the very first account can always be created and becomes admin).
ALLOW_REGISTRATION=true
# Require email verification before sign-in (only effective when SMTP is configured).
REQUIRE_EMAIL_VERIFICATION=false
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=20

# ── Defaults ─────────────────────────────────────────────────────────────────
# Timezone for new accounts when the browser's timezone can't be detected.
DEFAULT_TIMEZONE=UTC
# How far ahead recurring occurrences are created (days).
OCCURRENCE_HORIZON_DAYS=400
LOG_LEVEL=info

# ── Email (optional: password reset, verification, email reminders) ──────────
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); false for STARTTLS on 587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=BillFlow <no-reply@example.com>

# ── Web Push (optional: phone/desktop push notifications) ────────────────────
# Generate a pair with:
#   docker compose run --rm backend node dist/cli.js generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── Backups (optional profile: docker compose --profile backup up -d) ────────
BACKUP_PATH=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14

# ── Prebuilt images (optional; default builds locally) ───────────────────────
# BACKEND_IMAGE=ghcr.io/<owner>/skr-bill-calendar-backend:latest
# FRONTEND_IMAGE=ghcr.io/<owner>/skr-bill-calendar-frontend:latest
